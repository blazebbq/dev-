# Database
DATABASE_URL="postgresql://user:password@localhost:5432/gymtrackqr"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-here-generate-with-openssl-rand-base64-32"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Email (SMTP) - for magic link login
EMAIL_SERVER_HOST="smtp.example.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="your-smtp-user"
EMAIL_SERVER_PASSWORD="your-smtp-password"
EMAIL_FROM="noreply@gymtrackqr.com"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Debug / Guest mode — set to "true" to enable the "Continue as Guest" button on the sign-in page.
# Machine pages become viewable without authentication when this is enabled.
# NEVER set this to "true" in production.
GUEST_MODE=false
