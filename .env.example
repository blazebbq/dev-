# Database
DATABASE_URL="postgresql://user:password@localhost:5432/gymtrackqr"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-here-generate-with-openssl-rand-base64-32"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Email (SMTP) - for magic link login
EMAIL_SERVER_HOST="smtp.example.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="your-smtp-user"
EMAIL_SERVER_PASSWORD="your-smtp-password"
EMAIL_FROM="noreply@gymtrackqr.com"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Debug / Guest mode — guest browsing is always on; no env var needed.

# Dev bypass email — type this email on the sign-in page and click "Send Magic Link"
# to be signed in instantly without receiving an email. Leave blank to disable.
# NEVER set this in production.
DEV_BYPASS_EMAIL=letmeinadmin@test.com
